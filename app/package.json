{
  "name": "atelier-dtg",
  "productName": "AGOA DTG",
  "version": "0.1.17",
  "description": "AGOA DTG - Rémi Thollet Architecte",
  "author": "Agence Rémi Thollet Architecte",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "mammoth": "1.8.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.remithollet.atelierdtg",
    "productName": "AGOA DTG",
    "copyright": "Agence Rémi Thollet Architecte",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "google-client.json",
      "login.html",
      "google.js",
      "pdf.js",
      "splash.html",
      "renderer/**/*",
      "build/app.ico",
      "build/dtg-file.ico",
      "build/logo.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "dtg",
        "name": "Dossier DTG",
        "description": "Dossier de l'Atelier DTG",
        "icon": "build/dtg-file.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "shortcutName": "AGOA DTG",
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico",
      "artifactName": "AGOA-DTG-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "agence-rt",
        "repo": "agoa-dtg",
        "releaseType": "release"
      }
    ]
  },
  "agoa": {
    "google": {
      "clientId": "253318887290-luk51sg4fnsg7552foru42v8v8nmrnfj.apps.googleusercontent.com",
      "clientSecret": "",
      "allowed": [
        "4c62e33b6805a68d47650fc52009f5cd15c30eb94c0eb44700c8d235c186044a"
      ]
    }
  }
}